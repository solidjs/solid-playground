{
  "name": "solid-playground-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "start": "cd packages/playground && pnpm start",
    "build": "cd packages/playground && pnpm build",
    "dev": "cd packages/playground && pnpm dev",
    "panda:watch": "panda codegen --watch",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware .",
    "changeset": "changeset",
    "release": "pnpm --filter solid-repl build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/eslint-plugin": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/preset-panda": "^2.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "packageManager": "pnpm@12.15.0"
}
