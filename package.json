{
  "name": "solid-playground-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "start": "cd packages/playground && pnpm start",
    "build": "cd packages/playground && pnpm build",
    "dev": "cd packages/playground && pnpm dev",
    "panda:watch": "panda codegen --watch",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware ."
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/eslint-plugin": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "packageManager": "pnpm@12.11.2"
}
